<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Clock Outer Ring / Bezel -->
    <path
        android:pathData="M54,54m-27,0a27,27 0,1 1,54 0a27,27 0,1 1,-54 0"
        android:strokeWidth="2.5"
        android:strokeColor="#FFFFFF"
        android:fillColor="#1E293B" />

    <!-- Clock Inner Bezel Accent -->
    <path
        android:pathData="M54,54m-24,0a24,24 0,1 1,48 0a24,48 0,1 1,-48 0"
        android:strokeWidth="0.8"
        android:strokeColor="#38BDF8"
        android:fillColor="#00000000" />

    <!-- 12, 3, 6, 9 Major Hour Markers -->
    <!-- 12 o'clock -->
    <path
        android:pathData="M54,32L54,37"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeColor="#FFFFFF" />
    <!-- 6 o'clock -->
    <path
        android:pathData="M54,71L54,76"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeColor="#FFFFFF" />
    <!-- 3 o'clock -->
    <path
        android:pathData="M71,54L76,54"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeColor="#FFFFFF" />
    <!-- 9 o'clock -->
    <path
        android:pathData="M32,54L37,54"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeColor="#FFFFFF" />

    <!-- Diagonal Hour Markers (1, 2, 4, 5, 7, 8, 10, 11) -->
    <!-- 1 o'clock (cos 60, sin 60): 54+11=65, 54-19=35 -->
    <path
        android:pathData="M64,36.5L66.5,32"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:strokeColor="#94A3B8" />
    <!-- 2 o'clock (cos 30, sin 30): 54+19=73, 54-11=43 -->
    <path
        android:pathData="M71.5,44L76,41.5"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:strokeColor="#94A3B8" />
    <!-- 4 o'clock -->
    <path
        android:pathData="M71.5,64L76,66.5"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:strokeColor="#94A3B8" />
    <!-- 5 o'clock -->
    <path
        android:pathData="M64,71.5L66.5,76"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:strokeColor="#94A3B8" />
    <!-- 7 o'clock -->
    <path
        android:pathData="M44,71.5L41.5,76"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:strokeColor="#94A3B8" />
    <!-- 8 o'clock -->
    <path
        android:pathData="M36.5,64L32,66.5"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:strokeColor="#94A3B8" />
    <!-- 10 o'clock -->
    <path
        android:pathData="M36.5,44L32,41.5"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:strokeColor="#94A3B8" />
    <!-- 11 o'clock -->
    <path
        android:pathData="M44,36.5L41.5,32"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:strokeColor="#94A3B8" />

    <!-- Hour Hand (pointing towards ~10:10 / 10:25) -->
    <path
        android:pathData="M54,54L43,44"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:strokeColor="#FFFFFF" />

    <!-- Minute Hand (pointing towards ~2 / 10 min) -->
    <path
        android:pathData="M54,54L68,44"
        android:strokeWidth="2.0"
        android:strokeLineCap="round"
        android:strokeColor="#38BDF8" />

    <!-- Second / Accent Hand (subtle red or gold) -->
    <path
        android:pathData="M54,58L54,35"
        android:strokeWidth="1.0"
        android:strokeLineCap="round"
        android:strokeColor="#F43F5E" />

    <!-- Center Pivot Pin -->
    <path
        android:pathData="M54,54m-2.5,0a2.5,2.5 0,1 1,5 0a2.5,2.5 0,1 1,-5 0"
        android:fillColor="#F43F5E" />
    <path
        android:pathData="M54,54m-1,0a1,1 0,1 1,2 0a1,1 0,1 1,-2 0"
        android:fillColor="#FFFFFF" />
</vector>
